{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cachePriming": {
          "enable": false,
          "numThreads": 1
        },
        "cargo": {
          "allTargets": false
        },
        "check": {
          "workspace": false
        },
        "files": {
          "excludeDirs": ["target"]
        },
        "lru": {
          "capacity": 64
        }
      }
    }
  }
}
