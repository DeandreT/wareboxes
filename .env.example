# Database (Postgres-only).
# Local default matches docker-compose.yml.
DATABASE_URL=postgres://wareboxes_app:wareboxes_app@127.0.0.1:5433/wareboxes
MIGRATION_DATABASE_URL=postgres://wareboxes_admin:wareboxes_admin@127.0.0.1:5433/wareboxes

BIND_ADDR=127.0.0.1:8080

# Public self-service registration is disabled unless explicitly enabled.
ALLOW_PUBLIC_REGISTRATION=false

# Comma-separated exact origins. Empty disables browser cross-origin access.
CORS_ALLOWED_ORIGINS=

MAX_REQUEST_BODY_BYTES=1048576

# Browser sessions use server-side tenant context and an HTTP-only cookie.
WEB_SESSION_ABSOLUTE_TTL_SECONDS=43200
WEB_SESSION_IDLE_TTL_SECONDS=1800
# Keep false for local HTTP. Production HTTPS deployments must set this true.
SECURE_WEB_SESSION_COOKIE=false

# Optional: created on first startup if the user does not yet exist, and
# granted the `admin` permission via its per-user self role.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please

RUST_LOG=info,wareboxes_server=debug
