{
  "openapi": "3.1.0",
  "info": {
    "title": "Wareboxes Integration API",
    "description": "Version 1 partner integration surface for warehouse fulfillment workflows. Public operations are explicitly allowlisted; Wareboxes operator, RF, and administration endpoints are not part of this contract.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local development. Hosted environment URLs are supplied during integration onboarding."
    }
  ],
  "paths": {
    "/api/v1/integrations/order-intake/{source_key}/inventory-owners/{external_inventory_owner_key}/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Submit a partner fulfillment order.",
        "description": "Wareboxes durably retains the original payload before mapping partner owner, item, and UOM\nidentities. A `202` response therefore reports either `processed` or `quarantined`; callers\nmust inspect `status` instead of treating every accepted receipt as a created order.",
        "operationId": "submitIntegrationOrder",
        "parameters": [
          {
            "name": "source_key",
            "in": "path",
            "description": "Provisioned integration source identity. Item and UOM mappings are source-specific.",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "example": "partner-api"
          },
          {
            "name": "external_inventory_owner_key",
            "in": "path",
            "description": "Partner inventory-owner identity configured for this source. It is resolved within the authenticated tenant and owner scope.",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "example": "NORTHSTAR"
          },
          {
            "name": "x-wareboxes-tenant-id",
            "in": "header",
            "description": "Positive tenant context for the bearer credential. The request fails closed when the identity is not a member of this tenant.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "example": 12
          },
          {
            "name": "idempotency-key",
            "in": "header",
            "description": "Caller-generated identity for this submission. An exact retry returns the original outcome; reuse with a different payload or scope returns 409.",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[!-~]{1,200}$"
            },
            "example": "partner-order-SO-1001-v1"
          },
          {
            "name": "x-request-id",
            "in": "header",
            "description": "Optional caller correlation ID. Wareboxes echoes a valid value or assigns one.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "example": "partner-order-SO-1001-attempt-1"
          }
        ],
        "requestBody": {
          "description": "Partner order envelope. The path supplies the source and inventory-owner identities; internal Wareboxes IDs are not accepted in this payload.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntegrationOrderEnvelopeRequest"
              },
              "example": {
                "destination": {
                  "city": "Reno",
                  "company": "Northstar Retail",
                  "country": "US",
                  "email": "receiving@example.com",
                  "line1": "125 Shipping Lane",
                  "line2": "Dock 4",
                  "phone": "+1 775 555 0100",
                  "postal_code": "89502",
                  "recipient_name": "Receiving Team",
                  "region": "NV"
                },
                "lines": [
                  {
                    "external_item_key": "CLIENT-CASE",
                    "external_uom": "CS",
                    "line_key": "1",
                    "quantity": 4
                  }
                ],
                "order_key": "SO-1001",
                "rush": false,
                "ship_by": "2027-08-12T17:00:00Z"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "The payload is durably retained. Inspect `status`: `processed` includes `order_id`; `quarantined` includes `error_code` and `error_message` for operator remediation.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                },
                "description": "Request correlation ID."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationOrderIntakeResponse"
                },
                "examples": {
                  "processed": {
                    "summary": "Fulfillment demand created",
                    "value": {
                      "adapter_key": "wareboxes.fulfillment_order",
                      "applied_mapping_count": 1,
                      "attempt_count": 1,
                      "attempted_at": "2026-08-11T19:30:00Z",
                      "attempted_by": 7,
                      "correction_id": null,
                      "error_code": null,
                      "error_message": null,
                      "input_payload_sha256": "4cacc15b0023683e11cc4c371c585f8aefe1a12221edeb64290fbe35be4e4ccd",
                      "inventory_owner_id": 42,
                      "mapping_version": 2,
                      "order_id": 9001,
                      "order_revision": 1,
                      "processed_at": "2026-08-11T19:30:00Z",
                      "processing_attempt_id": 701,
                      "processing_id": 601,
                      "receipt_id": 501,
                      "revision": 1,
                      "status": "processed"
                    }
                  },
                  "quarantined": {
                    "summary": "Document retained for mapping remediation",
                    "value": {
                      "adapter_key": "wareboxes.fulfillment_order",
                      "applied_mapping_count": 0,
                      "attempt_count": 1,
                      "attempted_at": "2026-08-11T19:30:00Z",
                      "attempted_by": 7,
                      "correction_id": null,
                      "error_code": "item_mapping_not_found",
                      "error_message": "no active item mapping for line 1 (CLIENT-CASE / CS)",
                      "input_payload_sha256": "4cacc15b0023683e11cc4c371c585f8aefe1a12221edeb64290fbe35be4e4ccd",
                      "inventory_owner_id": 42,
                      "mapping_version": 2,
                      "order_id": null,
                      "order_revision": null,
                      "processed_at": null,
                      "processing_attempt_id": 702,
                      "processing_id": 602,
                      "receipt_id": 502,
                      "revision": 1,
                      "status": "quarantined"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A required header or path value is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "The bearer credential is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "The identity lacks tenant membership or the orders permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No active inventory-owner mapping is visible for the source, external owner key, and caller owner scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The idempotency key was reused with a different payload, content type, or scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "The request exceeds the deployment request-body limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type is not application/json or a +json media type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Wareboxes could not safely retain or process the submission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/integrations/x12-940/{source_key}/inventory-owners/{external_inventory_owner_key}/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Submit an X12 940 Warehouse Shipping Order using the Wareboxes v1 profile.",
        "operationId": "submitX12940Order",
        "parameters": [
          {
            "name": "source_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "example": "partner-edi"
          },
          {
            "name": "external_inventory_owner_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "example": "NORTHSTAR"
          },
          {
            "name": "x-wareboxes-tenant-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "example": 12
          },
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "example": "x12-isa-000000001-st-0001"
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128,
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "description": "One X12 004010 940 transaction in an ISA/IEA interchange. The Wareboxes v1 profile accepts W0501=N, an N1/N3/N4 ship-to loop, optional N9*RU and G62*10, and LX/W01 lines with SK or VP item keys.",
          "content": {
            "application/edi-x12": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "The raw interchange is retained and either processed or quarantined.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationOrderIntakeResponse"
                }
              }
            }
          },
          "400": {
            "description": "A header or path value is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "The bearer credential is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "The identity lacks tenant membership or order permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No visible active owner mapping exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The idempotency identity conflicts with a prior payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "The interchange exceeds the deployment body limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type is not application/edi-x12.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "The submission could not be retained safely.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
