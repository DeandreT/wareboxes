      "CustomerPortalShipmentStatus": {
        "type": "string",
        "enum": [
          "awaiting_manifest",
          "manifested",
          "partially_departed",
          "departed",
          "cancelled"
        ]
      },
      "CustomerPortalWorkspaceResponse": {
        "type": "object",
        "required": [
          "generated_at",
          "inventory",
          "orders",
          "shipments",
          "documents",
          "inventory_report_path"
        ],
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerPortalDocumentResponse"
            }
          },
          "generated_at": {
            "type": "string"
          },
          "inventory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerPortalInventoryResponse"
            }
          },
          "inventory_report_path": {
            "type": "string"
          },
          "orders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerPortalOrderResponse"
            }
          },
          "shipments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerPortalShipmentResponse"
            }
          }
        },
        "additionalProperties": false
      },
      "ErrorReason": {
        "type": "string",
        "description": "Stable machine-readable reason for an API failure.",
        "enum": [
          "unauthorized",
          "forbidden",
          "not_found",
          "validation_failed",
          "invalid_request",
          "conflict",
          "invalid_state_transition",
          "insufficient_inventory",
          "idempotency_key_required",
          "idempotency_key_reused",
          "precondition_required",
          "revision_conflict",
          "invalid_cursor",
          "method_not_allowed",
          "payload_too_large",
          "unsupported_media_type",
          "rate_limited",
          "internal_error"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Error response returned by every version 1 endpoint.",
        "required": [
          "reason",
          "message",
          "request_id"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "idempotency key was already used with a different request"
          },
          "reason": {
            "$ref": "#/components/schemas/ErrorReason"
          },
          "request_id": {
            "type": "string",
            "example": "partner-order-1001-attempt-1",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "violations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            }
          }
        },
        "additionalProperties": false
      },
      "FieldViolation": {
        "type": "object",
        "description": "Machine-addressable validation failure for one request field.",
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "Request field or logical input that failed validation.",
            "example": "lines[0].quantity"
          },
          "reason": {
            "type": "string",
            "description": "Stable validation explanation intended for an integration operator.",
            "example": "must be a positive integer"
          }
        },
        "additionalProperties": false
      },
      "FulfillmentOrderDestination": {
        "type": "object",
        "description": "Shipping destination captured with a fulfillment order.",
        "required": [
          "recipient_name",
          "line1",
          "city",
          "region",
          "postal_code",
          "country"
        ],
        "properties": {
          "city": {
            "type": "string",
            "example": "Reno",
            "maxLength": 100,
            "minLength": 1
          },
          "company": {
            "type": [
              "string",
              "null"
            ],
            "example": "Northstar Retail",
            "maxLength": 200
          },
          "country": {
            "type": "string",
            "example": "US",
            "maxLength": 100,
            "minLength": 1
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "example": "receiving@example.com",
            "maxLength": 254
          },
          "line1": {
            "type": "string",
            "example": "125 Shipping Lane",
            "maxLength": 200,
            "minLength": 1
          },
          "line2": {
            "type": [
              "string",
              "null"
            ],
            "example": "Dock 4",
            "maxLength": 200
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "example": "+1 775 555 0100",
            "maxLength": 64
          },
          "postal_code": {
            "type": "string",
            "example": "89502",
            "maxLength": 32,
            "minLength": 1
          },
          "recipient_name": {
            "type": "string",
            "example": "Receiving Team",
            "maxLength": 200,
            "minLength": 1
          },
          "region": {
            "type": "string",
            "example": "NV",
            "maxLength": 100,
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "IntegrationOrderEnvelopeLineRequest": {
        "type": "object",
        "required": [
          "line_key",
          "external_item_key",
          "external_uom",
          "quantity"
        ],
        "properties": {
          "external_item_key": {
            "type": "string",
            "description": "Partner item or SKU identity resolved through the active source mapping.",
            "example": "CLIENT-CASE",
            "maxLength": 200,
            "minLength": 1
          },
          "external_uom": {
            "type": "string",
            "description": "Partner UOM code resolved together with the external item key.",
            "example": "CS",
            "maxLength": 32,
            "minLength": 1
          },
          "line_key": {
            "type": "string",
            "description": "Partner line identity, unique within the order.",
            "example": "1",
            "maxLength": 200,
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "format": "int64",
            "description": "Positive demand quantity expressed in `external_uom`.",
            "example": 4,
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "IntegrationOrderEnvelopeRequest": {
        "type": "object",
        "description": "Partner-facing fulfillment order envelope retained before mapping and processing.",
        "required": [
          "order_key",
          "destination",
          "lines"
        ],
        "properties": {
          "destination": {
            "$ref": "#/components/schemas/FulfillmentOrderDestination"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IntegrationOrderEnvelopeLineRequest"
            },
            "description": "Demand lines. At least one line is required and line keys must be unique.",
            "minItems": 1
          },
          "order_key": {
            "type": "string",
            "description": "Partner order identity. Reuse for a different order is rejected.",
            "example": "SO-1001",
            "maxLength": 200,
            "minLength": 1
          },
          "rush": {
            "type": "boolean",
            "description": "Marks demand for warehouse prioritization; it does not bypass inventory policy.",
            "default": false,
            "example": false
          },
          "ship_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Optional RFC 3339 shipping deadline.",
            "example": "2027-08-12T17:00:00Z"
          }
        },
        "additionalProperties": false
      },
      "IntegrationOrderIntakeResponse": {
        "type": "object",
        "description": "Durable receipt and processing outcome returned by order intake.",
        "required": [
          "receipt_id",
          "processing_id",
          "processing_attempt_id",
          "correction_id",
          "input_payload_sha256",
          "inventory_owner_id",
          "adapter_key",
          "mapping_version",
          "status",
          "revision",
          "attempt_count",
          "applied_mapping_count",
          "order_id",
          "order_revision",
          "error_code",
          "error_message",
          "attempted_by",
          "attempted_at",
          "processed_at"
        ],
        "properties": {
          "adapter_key": {
            "type": "string",
            "example": "wareboxes.fulfillment_order"
          },
          "applied_mapping_count": {
            "type": "integer",
            "format": "int32",
            "example": 1,
            "minimum": 0
          },
          "attempt_count": {
            "type": "integer",
            "format": "int32",
            "example": 1,
            "minimum": 1
          },
          "attempted_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-11T19:30:00Z"
          },
          "attempted_by": {
            "type": "integer",
            "format": "int64",
            "example": 7,
            "minimum": 1
          },
          "correction_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "example": 801,
            "minimum": 1
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ],
            "example": "item_mapping_not_found"
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ],
            "example": "item mapping was not found for CLIENT-CASE / CS"
          },
          "input_payload_sha256": {
            "type": "string",
            "example": "4cacc15b0023683e11cc4c371c585f8aefe1a12221edeb64290fbe35be4e4ccd",
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "inventory_owner_id": {
            "type": "integer",
            "format": "int64",
            "example": 42,
            "minimum": 1
          },
          "mapping_version": {
            "type": "integer",
            "format": "int32",
            "description": "Version of the canonical intake adapter contract, not an individual item mapping revision.",
            "example": 2,
            "minimum": 1
          },
          "order_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "example": 9001,
            "minimum": 1
          },
          "order_revision": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "example": 1,
            "minimum": 1
          },
          "processed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "example": "2026-08-11T19:30:00Z"
          },
          "processing_attempt_id": {
            "type": "integer",
            "format": "int64",
            "example": 701,
            "minimum": 1
          },
          "processing_id": {
            "type": "integer",
            "format": "int64",
            "example": 601,
            "minimum": 1
          },
          "receipt_id": {
            "type": "integer",
            "format": "int64",
            "example": 501,
            "minimum": 1
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "example": 1,
            "minimum": 1
          },
          "status": {
            "$ref": "#/components/schemas/IntegrationOrderProcessingStatus"
          }
        },
        "additionalProperties": false
      },
      "IntegrationOrderProcessingStatus": {
        "type": "string",
        "enum": [
          "quarantined",
          "processed"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque bearer credential provisioned for the integration identity. It is not a JWT and must be stored as a secret."
      }
    }
  },
  "tags": [
    {
      "name": "Orders",
      "description": "Submit external fulfillment demand using partner inventory-owner, item, and UOM identities."
    },
    {
      "name": "Visibility",
      "description": "Read owner- and facility-scoped inventory, fulfillment status, reports, and documents."
    }
  ]
}
