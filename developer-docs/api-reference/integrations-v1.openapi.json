          "inventory_owner_id",
          "inventory_owner_name",
          "facility_id",
          "facility_name",
          "status",
          "carton_count",
          "shipped_quantity",
          "tracking_numbers",
          "created_at"
        ],
        "properties": {
          "carrier": {
            "type": [
              "string",
              "null"
            ]
          },
          "carton_count": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string"
          },
          "departed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "facility_id": {
            "type": "integer",
            "format": "int64"
          },
          "facility_name": {
            "type": "string"
          },
          "inventory_owner_id": {
            "type": "integer",
            "format": "int64"
          },
          "inventory_owner_name": {
            "type": "string"
          },
          "manifested_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "order_id": {
            "type": "integer",
            "format": "int64"
          },
          "order_key": {
            "type": "string"
          },
          "service": {
            "type": [
              "string",
              "null"
            ]
          },
          "shipment_id": {
            "type": "integer",
            "format": "int64"
          },
          "shipped_quantity": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "$ref": "#/components/schemas/CustomerPortalShipmentStatus"
          },
          "tracking_numbers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
