          "rush": {
            "type": "boolean"
          },
          "ship_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/CustomerPortalOrderStatus"
          }
        },
        "additionalProperties": false
      },
      "CustomerPortalOrderStatus": {
        "type": "string",
        "enum": [
          "open",
          "held",
          "processing",
          "awaiting_packing",
          "packing",
          "awaiting_shipment",
          "shipped",
          "cancelled",
          "void"
        ]
      },
      "CustomerPortalShipmentResponse": {
